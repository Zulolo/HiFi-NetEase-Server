# /etc/mpd.conf — generated by deploy/scripts/gen-mpd-conf.sh on @@STAMP@@
# Do not edit the generated block; put personal additions inside the USER REGION at the end.
# Design notes: docs/04 (audio pipeline) and docs/10 (deployment).

# ---- paths (all on the music disk, docs/03 §7) ----------------------------------------------
music_directory        "/srv/music"
playlist_directory     "/srv/music/playlists"
db_file                "/srv/data/mpd/database"
state_file             "/srv/data/mpd/state"
sticker_file           "/srv/data/mpd/sticker.sql"
log_file               "syslog"
pid_file               "/run/mpd/pid"

user                   "mpd"
group                  "audio"
filesystem_charset     "UTF-8"
auto_update            "yes"                    # cheap safety net; hifid triggers targeted updates too
auto_update_depth      "3"
restore_paused         "yes"
zeroconf_enabled       "yes"
zeroconf_name          "HiFi Server"

# ---- network ------------------------------------------------------------------------------
bind_to_address        "/run/mpd/socket"
bind_to_address        "0.0.0.0"
port                   "6600"
max_connections        "20"

# ---- buffers ---------------------------------------------------------------------------------
audio_buffer_size      "@@BUFFER_KB@@"

# ---- inputs ----------------------------------------------------------------------------------
input {
    plugin             "curl"
    verify_peer        "yes"
    verify_host        "yes"
    connect_timeout    "10"
    low_speed_limit    "1024"
    low_speed_time     "20"
}

# ---- decoders (MPD's parser needs one key per line inside a block) --------------------------
# All audio decoders stay enabled (dsf, dsdiff, flac, wavpack, opus, vorbis, mad, ffmpeg).
# The game/module-music decoders below are switched off; they are irrelevant here and one of
# them (sndfile) would otherwise shadow ffmpeg for WAV/AIFF.
decoder {
    plugin             "sndfile"
    enabled            "no"
}
decoder {
    plugin             "wildmidi"
    enabled            "no"
}
decoder {
    plugin             "sidplay"
    enabled            "no"
}
decoder {
    plugin             "gme"
    enabled            "no"
}
decoder {
    plugin             "modplug"
    enabled            "no"
}
decoder {
    plugin             "openmpt"
    enabled            "no"
}

# ---- bit-perfect defaults ---------------------------------------------------------------------
replaygain             "off"
volume_normalization   "no"

resampler {
    plugin             "soxr"
    quality            "medium"                 # only reached on the rare DSD->PCM fallback path
    threads            "2"
}

# ==== BEGIN GENERATED OUTPUTS (dac-setup.sh + gen-mpd-conf.sh) ====================================
@@GENERATED_OUTPUTS@@
# ==== END GENERATED OUTPUTS ======================================================================

# ==== USER REGION (preserved on regeneration) =====================================================
@@USER_REGION@@
# ==== END USER REGION ============================================================================

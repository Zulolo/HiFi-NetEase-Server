# Files that run on the Linux board must keep LF endings even on Windows checkouts
*.sh            text eol=lf
*.py            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.mount         text eol=lf
*.rules         text eol=lf
*.conf          text eol=lf
*.template      text eol=lf
*.example       text eol=lf
*.xml           text eol=lf
*.md            text
